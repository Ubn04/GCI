# ============================================
# CONFIGURATION ENVIRONNEMENT - CHANTIER AI
# ============================================
# Copier ce fichier en .env et remplir les valeurs

# ============================================
# BASE DE DONNÉES
# ============================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=chantier_ai
DB_USER=root
DB_PASSWORD=

# Pour Render:
# DB_HOST=mysql-db.render.internal
# DB_USER=root

# ============================================
# GOOGLE GEMINI API
# ============================================
# Obtenir votre clé: https://ai.google.dev/
GEMINI_API_KEY=

# ============================================
# APPLICATION
# ============================================
APP_NAME=ChantierAI
APP_URL=http://localhost/chantier-ai-php
APP_ENV=development
APP_DEBUG=true
APP_VERSION=1.0.0

# Pour Render:
# APP_URL=https://votre-app.onrender.com
# APP_ENV=production
# APP_DEBUG=false

# ============================================
# FICHIERS ET UPLOADS
# ============================================
UPLOAD_DIR=uploads/
MAX_FILE_SIZE=50M
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,pdf,doc,docx,xls,xlsx

# ============================================
# SÉCURITÉ
# ============================================
SESSION_TIMEOUT=3600
BCRYPT_ROUNDS=12

# ============================================
# EMAIL (SMTP)
# ============================================
MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@chantierai.com
MAIL_FROM_NAME=ChantierAI

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=debug
LOG_FILE=logs/app.log

# ============================================
# CORS (Pour API)
# ============================================
CORS_ORIGINS=http://localhost:3000
CORS_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_HEADERS=Content-Type,Authorization
