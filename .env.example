# Configuration de la base de données
DB_HOST=localhost
DB_PORT=3306
DB_NAME=chantier_ai
DB_USER=root
DB_PASSWORD=

# Configuration Google Gemini
GEMINI_API_KEY=AIzaSy...votre-clé-api

# Configuration de l'application
APP_URL=http://localhost/chantier-ai-php
