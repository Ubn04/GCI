APP_DEBUG=true

# Configuration des fichiers
UPLOAD_DIR=uploads/
MAX_FILE_SIZE=50M

# Configuration SMTP (optionnel)
MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
